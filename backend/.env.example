# Tuỳ chọn. API key có thể nhập trong app (nút Cài đặt) và được lưu ở ~/MovieReviewEditor/settings.json
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
WHISPER_MODEL=small
PLAN_MAX_RETRIES=3
# Mặc định dùng SQLite trong thư mục dữ liệu. Đặt DATABASE_URL để dùng PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/movie_review
# MRE_DATA_DIR=D:\MovieReviewData
# Base URL tuỳ chỉnh (relay/proxy). Bỏ trống = địa chỉ chính thức. Có thể nhập ngay trong app.
ANTHROPIC_BASE_URL=
ELEVENLABS_BASE_URL=
OPENAI_BASE_URL=
